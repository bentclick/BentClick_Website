# â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_APP_URL=http://localhost:3000

# â”€â”€ Database (PostgreSQL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Pooled URL used at runtime (e.g. Neon/Supabase pooler on Vercel).
DATABASE_URL=postgresql://bentclick:bentclick@127.0.0.1:55462/bentclick
# Direct URL used by Prisma migrations.
DIRECT_URL=postgresql://bentclick:bentclick@127.0.0.1:55462/bentclick

# â”€â”€ Auth (Better Auth) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Set to "true" only to bootstrap the first photographer account.
ALLOW_SIGNUP=true

# â”€â”€ Cloudflare R2 (private bucket) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bentclick-media
# Local development only: S3-compatible stand-in from docker-compose. Leave unset in production.
# R2_ENDPOINT=http://127.0.0.1:59090

# â”€â”€ Security â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Secret used to HMAC client IPs and sign gallery cookies.
GALLERY_TOKEN_SECRET=
# Shared secret for Vercel Cron / worker callbacks.
CRON_SECRET=

# â”€â”€ Email (Resend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RESEND_API_KEY=
EMAIL_FROM="Studio <galleries@yourdomain.com>"
# Signing secret of the Resend webhook (whsec_...), endpoint /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
